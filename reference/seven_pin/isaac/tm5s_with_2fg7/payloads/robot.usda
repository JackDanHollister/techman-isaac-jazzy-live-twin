#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "tm5s_with_2fg7"
    doc = """Sanitised Isaac Sim 6.0.1 URDF conversion bundle."""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "tm5s_with_2fg7" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </tm5s_with_2fg7/Physics/onrobot_2fg7_origin_to_base>,
        </tm5s_with_2fg7/Physics/onrobot_2fg7_left_finger_joint>,
        </tm5s_with_2fg7/Physics/onrobot_2fg7_right_finger_joint>,
        </tm5s_with_2fg7/Physics/onrobot_2fg7_origin_to_gripper_tcp>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </tm5s_with_2fg7/Geometry/base/link_0/link_1/link_2/link_3/link_4/link_5/link_6/flange/onrobot_qc_robot_side_link/onrobot_2fg7_origin/onrobot_2fg7_base_link>,
        </tm5s_with_2fg7/Geometry/base/link_0/link_1/link_2/link_3/link_4/link_5/link_6/flange/onrobot_qc_robot_side_link/onrobot_2fg7_origin/gripper_tcp>,
        </tm5s_with_2fg7/Geometry/base/link_0/link_1/link_2/link_3/link_4/link_5/link_6/flange/onrobot_qc_robot_side_link/onrobot_2fg7_origin/onrobot_2fg7_base_link/onrobot_2fg7_left_finger_link>,
        </tm5s_with_2fg7/Geometry/base/link_0/link_1/link_2/link_3/link_4/link_5/link_6/flange/onrobot_qc_robot_side_link/onrobot_2fg7_origin/onrobot_2fg7_base_link/onrobot_2fg7_right_finger_link>,
    ]
    token isaac:robotType = "Manipulator"

    over "Geometry"
    {
        over "base"
        {
            over "link_0"
            {
                over "link_1"
                {
                    over "link_2"
                    {
                        over "link_3"
                        {
                            over "link_4"
                            {
                                over "link_5"
                                {
                                    over "link_6"
                                    {
                                        over "flange"
                                        {
                                            over "onrobot_qc_robot_side_link"
                                            {
                                                over "onrobot_2fg7_origin"
                                                {
                                                    over "onrobot_2fg7_base_link" (
                                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                                    )
                                                    {
                                                        over "onrobot_2fg7_left_finger_link" (
                                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                                        )
                                                        {
                                                        }

                                                        over "onrobot_2fg7_right_finger_link" (
                                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                                        )
                                                        {
                                                        }

                                                        over "finger_tip_plane" (
                                                            prepend apiSchemas = ["IsaacSiteAPI"]
                                                        )
                                                        {
                                                        }
                                                    }

                                                    over "gripper_tcp" (
                                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                                    )
                                                    {
                                                        over "pin_grasp_tcp" (
                                                            prepend apiSchemas = ["IsaacSiteAPI"]
                                                        )
                                                        {
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "onrobot_2fg7_origin_to_base" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "onrobot_2fg7_left_finger_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "onrobot_2fg7_right_finger_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "onrobot_2fg7_origin_to_gripper_tcp" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}
