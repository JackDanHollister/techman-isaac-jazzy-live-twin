#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "tm5s_with_2fg7"
    doc = """Sanitised Isaac Sim 6.0.1 URDF conversion bundle."""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "tm5s_with_2fg7"
{
    over "Physics"
    {
        def MjcActuator "joint_1_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -17.453292846679688, -1.7453292608261108, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 157
            uniform double mjc:forceRange:min = -157
            uniform double[] mjc:gainPrm = [17.453292846679688, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            prepend rel mjc:target = </tm5s_with_2fg7/Physics/joint_1>
        }

        def MjcActuator "joint_2_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -17.453292846679688, -1.7453292608261108, 0, 0, 0, 0, 0, 0, 0]
