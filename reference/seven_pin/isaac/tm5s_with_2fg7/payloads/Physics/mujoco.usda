        def MjcActuator "onrobot_2fg7_left_finger_joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -1000, -100, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 140
            uniform double mjc:forceRange:min = -140
