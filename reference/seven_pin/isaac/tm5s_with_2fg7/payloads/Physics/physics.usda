#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "tm5s_with_2fg7"
    doc = """Sanitised Isaac Sim 6.0.1 URDF conversion bundle."""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "tm5s_with_2fg7"
{
    over "Geometry"
    {
        over "base" (
            prepend apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
        )
        {
            bool newton:selfCollisionEnabled = 0

            over "link_0" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0, 0, 0)
