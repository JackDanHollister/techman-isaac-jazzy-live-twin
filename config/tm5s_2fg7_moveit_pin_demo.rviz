Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TM5S + 2FG7 Visual Robot1
        - /Scanner Cloud1
        - /Live Alignment Cloud1
        - /Pin Axes + Gripper Lines1
        - /Live Alignment Status1
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Cell Size: 0.05
      Enabled: true
      Name: Grid
      Plane Cell Count: 30
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: TM5S + 2FG7 Visual Robot
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Alpha: 1
      Channel Name: rgb
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: Scanner Cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.003
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pin_axis_alignment/cloud
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Alpha: 1
      Channel Name: rgb
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: Live Alignment Cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 8
      Size (m): 0.012
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pin_axis_alignment/live_cloud
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pin_axis_alignment/markers
      Name: Pin Axes + Gripper Lines
      Queue Size: 100
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pin_axis_alignment/live_markers
      Name: Live Alignment Status
      Queue Size: 100
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.06
      Name: Target Frames
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: false
  Global Options:
    Background Color: 248; 248; 248
    Fixed Frame: base
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.2
      Focal Point:
        X: 0.45
        Y: 0.0
        Z: 0.18
      Name: Current View
      Pitch: 0.6
      Target Frame: base
      Yaw: -0.7
Window Geometry:
  Height: 980
  Width: 1400
